  "weighted_quantiles": [
    {
      "name": "techspec_baseline_equal_weights",
      "description": "Techspec line 65: equal weights for rates [10000, 20000, 30000, 40000] paise/kg",
      "observations": [
        {"rate_paise_per_unit": 10000, "weight": 1.0, "observation_id": "obs_0"},
        {"rate_paise_per_unit": 20000, "weight": 1.0, "observation_id": "obs_1"},
        {"rate_paise_per_unit": 30000, "weight": 1.0, "observation_id": "obs_2"},
        {"rate_paise_per_unit": 40000, "weight": 1.0, "observation_id": "obs_3"}
