      "expected_q1": 10000,
      "expected_median": 20000,
      "expected_q3": 30000
    },
    {
      "name": "recency_decay_weights",
      "description": "Observations with ages 0, 7, 14, 21 days with rates 40000, 30000, 20000, 10000",
      "observations": [
        {"rate_paise_per_unit": 40000, "weight": 1.0, "observation_id": "obs_fresh"},
        {"rate_paise_per_unit": 30000, "weight": 0.5, "observation_id": "obs_7d"},
        {"rate_paise_per_unit": 20000, "weight": 0.25, "observation_id": "obs_14d"},
        {"rate_paise_per_unit": 10000, "weight": 0.125, "observation_id": "obs_21d"}
      ],
      "expected_q1": 30000,
      "expected_median": 40000,
      "expected_q3": 40000
    },
    {
      "name": "single_observation",
      "description": "Single observation returns its rate across all quantiles",
      "observations": [
        {"rate_paise_per_unit": 25000, "weight": 1.0, "observation_id": "obs_single"}
      ],
      "expected_q1": 25000,
      "expected_median": 25000,
      "expected_q3": 25000
    },
    {
      "name": "empty_observations",
