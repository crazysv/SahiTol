FROM python:3.10-slim

WORKDIR /app

# Install system dependencies: libpq for psycopg3, curl for health check
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first for better layer caching
COPY services/api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY services/api /app

# Copy seed data and scripts (needed by seed_production.py and reference bootstrap)
COPY data /data
COPY scripts /scripts

# Copy and wire up the production startup script
COPY infra/start.sh /start.sh
# Strip Windows CRLF so the shebang works in Linux (git on Windows may store \r\n)
RUN sed -i 's/\r$//' /start.sh && chmod +x /start.sh

# Render free plan requires port 10000
EXPOSE 10000

# Production: migrate → seed → serve
# Local override: docker run ... uvicorn app.main:app --port 8000
CMD ["/bin/sh", "/start.sh"]
