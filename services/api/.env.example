# SahiTol API Environment Configuration Template
# Consult docs/11_SECRETS_CHECKLIST.md before setting production values.
# DO NOT commit real secrets to Git.

# Database connection (PostgreSQL with PostGIS)
DATABASE_URL=postgresql+psycopg://sahitol:sahitol_secret@localhost:5432/sahitol_db
MIGRATION_DATABASE_URL=postgresql+psycopg://sahitol:sahitol_secret@localhost:5432/sahitol_db

# Security & Authentication
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-minimum-32-chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PIN_PEPPER=dev-pin-pepper-minimum-16-bytes

# Media Storage Configuration ('local' or 'supabase')
STORAGE_BACKEND=local
LOCAL_MEDIA_ROOT=./media_storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sahitol-media

# Networking, CORS & Base URLs
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Isolated Demo Configuration
DEMO_MODE=true
DEMO_TENANT_ID=demo-tenant-0001
